# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reai_user:reai_password@localhost:5432/renewable_energy_ai

# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Data paths ─────────────────────────────────────────────────────────────
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# ─── ML settings ────────────────────────────────────────────────────────────
MODEL_ARTIFACT_DIR=./backend/app/ml/artifacts

# ─── Optional: Open-Meteo API (no key needed, free tier) ────────────────────
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# ─── Optional: NREL API key (register free at developer.nrel.gov) ───────────
# NREL_API_KEY=your_nrel_api_key_here
